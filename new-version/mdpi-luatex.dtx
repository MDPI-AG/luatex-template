% \subsubsection{Books} 
% This tests if this a Book or a Monograph
%    \begin{macrocode}
\ExplSyntaxOn
\newcommand\isBookContribution
 {
   \str_case:onTF {\@arttype}
    {
      {Book}{}
      {Monograph}{}
    }  
 }
