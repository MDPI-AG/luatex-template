% \subsubsection{Chicago style journals}
% These journals use the \texttt{mdpi\_chicago} bibliography style. 
% \begin{macro}{\isChicagoStyle}
%    \begin{macrocode}
\clist_new:N  \l__mdpi_journal_chicagostyle_clist
\clist_set:Nn \l__mdpi_journal_chicagostyle_clist
 {
     arts
    ,genealogy
    ,histories
    ,humanities
    ,laws
    ,literature
    ,religions
    ,risks
    ,socsci
    ,preprintschicago  %% Just use for preprints, not a real Chicago journal
    ,chicagojournal    %% Just use for chicago submission, not a real Chicago journal
 }
\prg_new_conditional:Npnn \__mdpi_is_journal_chicagostyle: {TF}
 {
   \clist_if_in:NoTF \l__mdpi_journal_chicagostyle_clist {\@journal}
    {\prg_return_true:}
    {\prg_return_false:}
 }
\newcommand\isChicagoStyle{\__mdpi_is_journal_chicagostyle:TF} 
%    \end{macrocode}
% \end{macro}
% 
