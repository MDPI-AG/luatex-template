    ,econometrics  % Transfer to APA type
    ,economies     % Transfer to APA type
    ,education     % Transfer to APA type
    ,ejihpe        % Transfer to APA type
    ,famsci        % Transfer to APA type
    ,games         % Transfer to APA type
    ,humans        % Transfer to APA type
    ,ijcs          % Transfer to APA type
    ,ijfs          % Transfer to APA type
    ,investment    % New APA Journal
    ,jintelligence % Transfer to APA type from 19 Dec. 2025
    ,journalmedia  % Transfer to APA type
    ,jrfm          % Transfer to APA type
    ,jsam          % New APA Journal
    ,languages     % Transfer to APA type
    ,peacestud     % New APA Journal
    ,projmanag     % New APA Journal
    ,psycholint    % Transfer to APA type
    ,publications  % Transfer to APA type
    ,tourismhosp   % Transfer to APA type
    ,youth         % Transfer to APA type
    ,preprintsapa  %% Just use for preprints, not a real APA journal
    ,apajournal    %% Just use for APA submission, not a real APA journal
 }
\prg_new_conditional:Npnn \__mdpi_is_journal_apastyle: {TF}
 {
  \clist_if_in:NoTF \l__mdpi_journal_apastyle_clist {\@journal}
   {\prg_return_true:}
   {\prg_return_false:}
 }
\newcommand{\isAPAStyle}{\__mdpi_is_journal_apastyle:TF}
%    \end{macrocode}
% \end{macro}
% \subsubsection{APA or Chicago style journals}
% 
% A combination of both tests: true if a journal is either APA or a Chicago style journal.
% \begin{macro}{\ifAPAorChicago}
%    \begin{macrocode}
\prg_new_conditional:Npnn \__mdpi_is_journal_apa_or_chicago_style: {TF}
 {
   \__mdpi_is_journal_chicagostyle:TF
    {
      \prg_return_true:
    }
    {
      \__mdpi_is_journal_apastyle:TF
       {
        \prg_return_true:
       }
       {
         \prg_return_false:
       }
    }
 }
\newcommand{\isAPAorChicago}{\__mdpi_is_journal_chicagostyle:TF}
\ExplSyntaxOff
