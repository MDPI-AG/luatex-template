 \newcommand{\contentleftcolumn}
  {%
    \leftcolFont
    \ifthenelse
      {%
       \equal{\@arttype}{Supfile}
       \OR \equal{\@journal}{preprints}
       \OR \equal{\@journal}{preprintschicago}
       \OR \equal{\@journal}{preprintsapa}
      }
      {}
      {%
