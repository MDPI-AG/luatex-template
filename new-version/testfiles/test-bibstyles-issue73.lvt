% regression-test should be before the class as microtype defines \pdfoutput!
\input{regression-test}

\documentclass{mdpi-luatex}
\usepackage{lipsum}
% no title
\RemoveFromHook{begindocument/end}[mdpi-luatex]
\begin{document}
\START

\makeatletter 
\def\@journaltype{APA}

\isAPAStyle{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{TRUE}{\test}
\isAPAorChicago{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{TRUE}{\test}
\isChicagoStyle{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{FALSE}{\test}

\def\@journaltype{Chicago}%CHICAGO

\isAPAStyle{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{FALSE}{\test}
\isAPAorChicago{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{TRUE}{\test}
\isChicagoStyle{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{TRUE}{\test}

\def\@journaltype{ACS}

\isAPAStyle{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{FALSE}{\test}
\isAPAorChicago{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{FALSE}{\test}
\isChicagoStyle{\def\test{TRUE}}{\def\test{FALSE}}
\ASSERT{FALSE}{\test}
\end{document} 